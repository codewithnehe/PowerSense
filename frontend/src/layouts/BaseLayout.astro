---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta
      name="description"
      content="PowerSense tells you when power is out or likely to go in Nigeria, and what to do about it."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
