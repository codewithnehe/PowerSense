# Hosted Gemma endpoint (must be OpenAI-compatible chat completions).
# This must serve a Gemma model. Do not point it at a closed model.
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_API_KEY=

# Request tuning
GEMMA_TIMEOUT_SECONDS=90
GEMMA_MAX_TOKENS=4000
GEMMA_TEMPERATURE=0.2

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
